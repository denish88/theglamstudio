# Copy to env/.env.dev or env/.env.prod and fill in values

NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://localhost:27017/theglamclub_dev
JWT_SECRET=change-me
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Cloudflare R2 (required for photos + video signed playback)
# Same keys you already use for photo uploads — no new keys required for video
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
# Optional: only if you use a custom R2/CDN domain for media
# R2_PUBLIC_URL=https://media.yourdomain.com

# Web Push (VAPID) — generate with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@theglam.club
